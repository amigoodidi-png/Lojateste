# Copie este arquivo para .env.local e preencha. O .env.local nunca vai para o GitHub.

# Banco local do Supabase (valor padrão do `npx supabase start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Endereço público do site (usado no sitemap, Open Graph e links de compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal para o hash anônimo dos cliques. Troque por um texto aleatório e longo.
CLIQUES_SAL=troque-este-texto

# Shopee Affiliate Open API (preencher só quando tiver o acesso; nunca colar no código)
# Peça o acesso em https://help.shopee.com.br/portal/webform/bbce78695c364ba18c9cbceb74ec9091
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
